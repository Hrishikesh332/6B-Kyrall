# Copy to backend/.env. Start scripts load this file; never commit it.
# Starting provider: claude, workshop or openai. You can also switch from
# the app (Integrations -> Model provider); that choice is saved in the data folder
# and takes over from this line until you change it again in the app.
6B_PROVIDER=workshop
# Claude Code uses the account signed in on this computer (claude auth login).
# Workshop runs without a model.
# Optional direct API alternative: 6B_PROVIDER=openai
OPENAI_API_KEY=
# Direct API mode requires an explicit model.
6B_MODEL=
# Claude Code: the CLI bundled with the Python packages is used unless `claude` is on
# PATH or a path is set here. Empty model uses the account default (opus/sonnet/haiku
# aliases pick the newest model). ANTHROPIC_API_KEY is only for Console API billing
# instead of a Claude subscription login.
6B_CLAUDE_BINARY=
6B_CLAUDE_MODEL=
6B_CLAUDE_TIMEOUT=1200
ANTHROPIC_API_KEY=
6B_MAX_TOOL_CALLS=80
6B_REASONING_EFFORT=medium
6B_MAX_MODEL_TURNS=24
6B_MAX_OUTPUT_TOKENS=6000
# Soft aggregate ceiling, including cached input repeated across tool rounds.
# Complex mechanisms need more than the 200000-token simple-task setting.
6B_MAX_RUN_TOKENS=2000000
6B_CAD_TIMEOUT=90
# Overall wall-clock limit for each tool's async work (includes reference downloads).
6B_TOOL_TIMEOUT=180
6B_DATA_DIR=./data
# Optional local API protection. UI prompts for this token when set.
6B_API_TOKEN=
# Hosted deployments only (e.g. Railway): listen on all interfaces (PORT is used when set),
# accept these Host names (".example.com" matches subdomains), and trust the proxy's
# X-Forwarded-Proto header. Leave empty for local use.
6B_HOST=
6B_ALLOWED_HOSTS=
6B_BEHIND_PROXY=
# Domain list for optional read-only reference fetching; no arbitrary network access.
# Example: 6B_REFERENCE_DOMAINS=docs.example.com,example.com
6B_REFERENCE_DOMAINS=

# Optional read-only observer for an existing Isaac Sim MCP container.
# Use an existing SSH alias; no credentials are sent to the browser. All four
# values are required, e.g. 6B_ISAAC_PYTHON=/opt/isaaclab-venv/bin/python.
6B_ISAAC_SSH_HOST=
6B_ISAAC_CONTAINER=
6B_ISAAC_PYTHON=
6B_ISAAC_MCP_PATH=
# Optional Onshape import (or connect from Integrations in the app)
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_BASE_URL=https://cad.onshape.com

# Optional Google sign-in and Realtime Database cloud copy (Firebase).
# FIREBASE_SERVICE_ACCOUNT is the Admin SDK key: paste the service account JSON on one line
# or its base64 (base64 -i key.json). Keep it only here or in your host's secret variables;
# never commit the key file. With it set, every chat is copied to the Realtime Database when a
# run starts and when it stops, under users/<uid>/ (6B_CLOUD_SYNC=0 turns that off).
FIREBASE_SERVICE_ACCOUNT=
# Turning on Google sign-in also needs the web app's public config (Firebase console ->
# Project settings -> Your apps -> Web app). Auth domain defaults to <project>.firebaseapp.com.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Empty: https://<project>-default-rtdb.firebaseio.com. Paste the URL shown in Firebase ->
# Realtime Database if the database is in another region.
FIREBASE_DATABASE_URL=
6B_CLOUD_SYNC=1
# Personal workspaces work signed out (the Sign in with Google button is top right); set this
# to require an account. Hosted workspaces always require one.
6B_REQUIRE_SIGN_IN=
# The admin: the one Google account (verified email) that may change workspace-wide settings
# (model connection, Onshape keys, Bambu printer, rules, scheduled jobs) and see the Isaac
# simulation. A personal workspace with an admin is private to it: other accounts cannot sign
# in, and signing in takes the chats made while signed out. Set it here or in your host's
# variables, never in code; the browser is told only whether it is the admin, never this email.
# Empty: no admin, and any account that signs in takes the signed-out chats.
6B_OWNER_EMAIL=
